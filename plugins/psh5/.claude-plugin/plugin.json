{
  "name": "psh5",
  "description": "Windows PowerShell 5.x LSP (PowerShellEditorServices)",
  "version": "2.0.0",
  "author": {
    "name": "RAY",
    "url": "https://github.com/raystyle"
  },
  "homepage": "https://github.com/raystyle/plugins",
  "repository": "https://github.com/raystyle/plugins",
  "license": "MIT",
  "lspServers": {
    "powershell": {
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "${CLAUDE_PLUGIN_ROOT}/shared-scripts/Start-PsesStdio.ps1"
      ],
      "extensionToLanguage": {
        ".ps1": "powershell",
        ".psm1": "powershell",
        ".psd1": "powershell"
      },
      "startupTimeout": 120000,
      "maxRestarts": 3
    }
  }
}
